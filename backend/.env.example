# Optional online social sign-in. Copy to backend/.env.local for IntelliJ when
# its working directory is the repository root. See README.md for other launchers.
APP_OAUTH_ENABLED=false
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_COOKIE_SECURE=false
