{
  "name": "deadlinr-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --config playwright.unit.config.ts",
    "test:capture": "playwright test --config playwright.capture.config.ts",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript http://localhost:8080/v3/api-docs -o src/lib/api.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/lib/api.d.ts",
    "analyze": "node scripts/analyze.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "deps:check": "depcheck --ignore-patterns=.next*,node_modules --ignores=autoprefixer,postcss"
  },
  "dependencies": {
    "@blocknote/core": "^0.29.1",
    "@blocknote/react": "^0.29.1",
    "@blocknote/shadcn": "^0.29.1",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.13",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "next": "^15.5.26",
    "next-themes": "^0.4.3",
    "react": "18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.26",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
