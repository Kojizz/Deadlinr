# Docker Compose reads a root .env file. For a native backend, export the
# variables in its launching environment; Spring does not load this file itself.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=deadlinr
DB_USERNAME=deadlinr
DB_PASSWORD=deadlinr

# --- JWT ---
# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=deadlinr-dev-secret-key-change-me-0123456789abcdef0123456789abcdef
# Access token lifetime in ms (default: 15 minutes)
JWT_ACCESS_EXPIRATION=900000
# Refresh token lifetime in ms (default: 7 days)
JWT_REFRESH_EXPIRATION=604800000

# --- Auth cookies / CORS ---
# Set to true behind HTTPS (production)
APP_COOKIE_SECURE=false
# Comma-separated origin patterns allowed for the frontend.
# Dev default: localhost/127.0.0.1 and private LAN ranges on any port.
# Production: restrict to exact origins, e.g. https://app.example.com
APP_CORS_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*,http://192.168.*:*,http://10.*:*

# --- Login rate limiting ---
LOGIN_RATE_CAPACITY=5
LOGIN_RATE_REFILL_MINUTES=1

# --- Mailpit (dev email catcher) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Observability ---
PROMETHEUS_PORT=9090
# 3001 because the Next.js dev server owns 3000
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
